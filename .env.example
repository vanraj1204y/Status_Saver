# Copy this file to `.env` and fill in real values.
# See the top of `.env`'s own comments (once created) for how each key is
# consumed — in short: android/app/build.gradle.kts reads this file directly
# for the Android identity fields, and lib/core/config/app_config.dart reads
# a subset of it via --dart-define-from-file for the update/legal-docs URLs.

# Display name shown to users (drives the Android app label via AndroidManifest.xml's ${appLabel}).
APP_NAME=StatusNest

# Release version shown to users / used for versionName.
APP_VERSION_NAME=1.0.0

# Android versionCode (must increase on every Play Store upload).
APP_VERSION_CODE=1

# Android applicationId (installed-app identity / Play Store package id).
APP_PACKAGE_NAME=com.twocompo.statusnest

# Path segment identifying this app to the shared update/legal-docs worker.
APP_SLUG=StatusNest

# Shared backend for the force-update version check and the legal documents
# (privacy policy / terms) fetched at build time.
UPDATE_API_BASE_URL=https://app-update-server.kolivanraj1204y.workers.dev

# Master kill switch for the force-update gate (true/false).
FORCE_UPDATE_ENABLED=true
